ENV=development
PORT=8080
READ_TIMEOUT=30s
WRITE_TIMEOUT=30s
JWT_SECRET=change-me

# PostgreSQL
POSTGRES_DSN=postgres://catalog:catalog@localhost:5432/catalog?sslmode=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_CONN_MAX_LIFETIME=5m

# SQL Server
MSSQL_DSN=sqlserver://sa:Password1!@localhost:1433?database=catalog
MSSQL_MAX_OPEN_CONNS=10

# Oracle
ORACLE_DSN=oracle://user:password@localhost:1521/ORCLPDB1
ORACLE_MAX_OPEN_CONNS=10

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=15m

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_PRODUCT_TOPIC=automotive.products
KAFKA_INVENTORY_TOPIC=automotive.inventory
KAFKA_FITMENT_TOPIC=automotive.fitments
KAFKA_CONSUMER_GROUP=catalog-service
KAFKA_COMMIT_INTERVAL=1s

# AWS
AWS_REGION=us-east-1
AWS_S3_BUCKET=automotive-catalog-assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
